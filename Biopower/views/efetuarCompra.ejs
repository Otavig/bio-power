<main class="page-content page-recebimento">
  <section class="recebimento-section">
    <div class="section-header">
      <span class="section-tag">Entrada de estoque</span>
      <h1>Recebimento de Produtos</h1>
      <p>Use este formulário para registrar a entrada de itens no estoque.</p>
    </div>

    <form action="/efetuar-compra" method="POST" class="recebimento-form">
      <div class="form-row">
        <label for="produtoId">ID do Produto</label>
        <input id="produtoId" type="number" name="produtoId" required placeholder="Digite o ID do produto" />
      </div>

      <div class="form-row">
        <label for="numeroLote">Número do Lote</label>
        <input id="numeroLote" type="text" name="numeroLote" required placeholder="Digite o número do lote" />
      </div>

      <div class="form-row">
        <label for="dataValidade">Validade</label>
        <input id="dataValidade" type="date" name="dataValidade" required />
      </div>

      <div class="form-row">
        <label for="quantidade">Quantidade Recebida</label>
        <input id="quantidade" type="number" name="quantidade" required placeholder="Digite a quantidade recebida" min="1" />
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-submit">Confirmar Entrada</button>
      </div>
    </form>
  </section>
</main>

