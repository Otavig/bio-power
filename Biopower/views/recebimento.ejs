<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Pagamento — Bio-pO</title>
  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --bg:       #ffffff;
      --bg2:      #181a1b;
      --bg3:      #212326;
      --borda:    #2e3133;
      --laranja:  #a3080c;
      --laranja2: #800609;
      --amarelo:  #fbbf24;
      --texto:    #f1f0ee;
      --muted:    #8a8f96;
      --muted2:   #5c6066;
      --verde:    #22c55e;
      --azul:     #38bdf8;
      --radius:   10px;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Barlow', sans-serif;
      background: var(--bg);
      color: var(--texto);
      min-height: 100vh;
    }

    /* ---- TIPOGRAFIA ---- */
    .titulo, h1, h2, h3, h4 {
      font-family: 'Barlow Condensed', sans-serif;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    /* ---- LAYOUT ---- */
    .page-wrap {
      max-width: 1080px;
      margin: 0 auto;
      padding: 2rem 1rem 3rem;
    }

    /* ---- HEADER DA PÁGINA ---- */
    .page-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 2.5rem;
      border-bottom: 1px solid var(--borda);
      padding-bottom: 1.25rem;
    }
    .brand {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 900;
      font-size: 1.7rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      line-height: 1;
      color: #181a1b;
    }
    .brand span { color: var(--laranja); }
    .brand small {
      display: block;
      font-size: 0.55rem;
      letter-spacing: 0.25em;
      color: var(--muted);
      font-weight: 600;
    }
    .lock-badge {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.75rem;
      color: var(--verde);
      font-weight: 600;
      letter-spacing: 0.05em;
      background: rgba(34,197,94,0.08);
      border: 1px solid rgba(34,197,94,0.2);
      border-radius: 20px;
      padding: 5px 12px;
    }

    /* ---- SEÇÃO CARD ---- */
    .sec {
      background: var(--bg2);
      border: 1px solid var(--borda);
      border-radius: var(--radius);
      padding: 1.5rem;
      margin-bottom: 1.25rem;
    }
    .sec-title {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 700;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: var(--muted);
      margin-bottom: 1.1rem;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .sec-title::before {
      content: '';
      display: inline-block;
      width: 3px;
      height: 14px;
      background: var(--laranja);
      border-radius: 2px;
    }

    /* ---- ITENS DO PEDIDO ---- */
    .item-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid var(--borda);
    }
    .item-row:last-of-type { border-bottom: none; }
    .item-thumb {
      width: 52px;
      height: 52px;
      border-radius: 8px;
      background: var(--bg3);
      border: 1px solid var(--borda);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.4rem;
      flex-shrink: 0;
    }
    .item-nome {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 700;
      font-size: 0.95rem;
      color: var(--texto);
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }
    .item-sub {
      font-size: 0.75rem;
      color: var(--muted);
      margin-top: 2px;
    }
    .item-preco {
      margin-left: auto;
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 700;
      font-size: 1rem;
      color: var(--texto);
      white-space: nowrap;
    }
    .qtd-pill {
      background: var(--laranja);
      color: #000;
      border-radius: 4px;
      font-size: 0.68rem;
      font-weight: 700;
      padding: 1px 6px;
      font-family: 'Barlow Condensed', sans-serif;
      letter-spacing: 0.04em;
    }

    /* ---- TOTAIS ---- */
    .total-linha {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
      color: var(--muted);
      padding: 5px 0;
    }
    .total-linha.desc { color: var(--verde); font-weight: 600; }
    .total-final {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      border-top: 1px solid var(--borda);
      margin-top: 8px;
      padding-top: 12px;
    }
    .total-final .label {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--muted);
    }
    .total-final .valor {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 900;
      font-size: 1.8rem;
      color: var(--texto);
      letter-spacing: -0.01em;
    }
    .total-final .valor span {
      font-size: 1rem;
      color: var(--muted);
      font-weight: 600;
    }

    /* ---- MÉTODOS DE PAGAMENTO ---- */
    .metodos {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-bottom: 1.5rem;
    }
    .metodo-btn {
      background: var(--bg3);
      border: 1.5px solid var(--borda);
      border-radius: 10px;
      padding: 1rem 0.5rem;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 7px;
      user-select: none;
    }
    .metodo-btn:hover {
      border-color: var(--laranja);
      background: rgba(249,115,22,0.06);
    }
    .metodo-btn.ativo {
      border-color: var(--laranja);
      background: rgba(249,115,22,0.1);
      box-shadow: 0 0 0 3px rgba(249,115,22,0.15);
    }
    .metodo-btn .m-icon {
      font-size: 1.4rem;
      color: var(--muted);
      transition: color 0.2s;
    }
    .metodo-btn.ativo .m-icon { color: var(--laranja); }
    .metodo-btn .m-label {
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 700;
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      transition: color 0.2s;
    }
    .metodo-btn.ativo .m-label { color: var(--laranja); }
    .metodo-btn .m-badge {
      font-size: 0.63rem;
      background: rgba(34,197,94,0.12);
      color: var(--verde);
      border-radius: 4px;
      padding: 1px 6px;
      font-weight: 600;
      letter-spacing: 0.05em;
    }

    /* ---- PAINÉIS CONDICIONAL ---- */
    .painel { display: none; }
    .painel.visivel {
      display: block;
      animation: fadeIn 0.28s ease;
    }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(8px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    /* ---- FORMULÁRIO CARTÃO ---- */
    .form-label-dark {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--muted);
      margin-bottom: 6px;
      display: block;
    }
    .input-dark {
      background: var(--bg3);
      border: 1px solid var(--borda);
      border-radius: 8px;
      color: var(--texto);
      font-family: 'Barlow', sans-serif;
      font-size: 0.9rem;
      padding: 10px 14px;
      width: 100%;
      transition: border-color 0.2s, box-shadow 0.2s;
      outline: none;
      -webkit-appearance: none;
    }
    .input-dark:focus {
      border-color: var(--laranja);
      box-shadow: 0 0 0 3px rgba(249,115,22,0.15);
      background: var(--bg3);
      color: var(--texto);
    }
    .input-dark::placeholder { color: var(--muted2); }
    select.input-dark option { background: var(--bg3); }

    /* CARD VISUAL PREVIEW */
    .card-preview {
      border-radius: 14px;
      padding: 1.3rem 1.4rem;
      background: linear-gradient(135deg, #1c1c1e 0%, #2a2a2d 40%, #1a1517 100%);
      border: 1px solid #3a3838;
      position: relative;
      overflow: hidden;
      margin-bottom: 1.25rem;
      min-height: 158px;
    }
    .card-preview::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at top right, rgba(249,115,22,0.18) 0%, transparent 65%);
      pointer-events: none;
    }
    .card-preview .card-chip {
      width: 34px; height: 26px;
      background: linear-gradient(135deg, #c8a84b, #f0d080);
      border-radius: 5px;
      margin-bottom: 1rem;
    }
    .card-preview .card-num {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 1.15rem;
      letter-spacing: 0.22em;
      font-weight: 600;
      color: #e8e8e8;
      margin-bottom: 1rem;
    }
    .card-preview .card-footer-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }
    .card-preview .cf-lbl {
      font-size: 0.6rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: #888;
      margin-bottom: 2px;
    }
    .card-preview .cf-val {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 0.9rem;
      font-weight: 700;
      color: #e8e8e8;
      letter-spacing: 0.04em;
    }
    .card-preview .card-bandeira {
      font-size: 1.9rem;
      color: #e0e0e0;
      opacity: 0.85;
    }

    /* ---- PIX PAINEL ---- */
    .pix-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0.5rem 0 1rem;
      gap: 1rem;
    }
    .pix-qr-container {
      position: relative;
      width: 200px;
      height: 200px;
      background: white;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 3px solid var(--laranja);
      box-shadow: 0 0 30px rgba(249,115,22,0.25);
    }
    .pix-qr-container canvas {
      border-radius: 8px;
    }
    .pix-logo-overlay {
      position: absolute;
      width: 40px;
      height: 40px;
      background: white;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      color: #32bcad;
      border: 2px solid #eee;
      font-weight: 900;
      font-family: 'Barlow Condensed', sans-serif;
    }
    .pix-chave {
      background: var(--bg3);
      border: 1px solid var(--borda);
      border-radius: 8px;
      padding: 10px 14px;
      display: flex;
      align-items: center;
      gap: 10px;
      width: 100%;
      max-width: 340px;
    }
    .pix-chave .chave-val {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 0.82rem;
      color: var(--muted);
      letter-spacing: 0.04em;
      flex: 1;
      word-break: break-all;
    }
    .pix-chave button {
      background: none;
      border: none;
      color: var(--laranja);
      cursor: pointer;
      font-size: 0.9rem;
      padding: 0;
      flex-shrink: 0;
    }
    .pix-timer {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 0.85rem;
      color: var(--amarelo);
      letter-spacing: 0.06em;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .pix-info {
      font-size: 0.8rem;
      color: var(--muted);
      text-align: center;
      line-height: 1.6;
      max-width: 300px;
    }
    .pix-steps {
      display: flex;
      flex-direction: column;
      gap: 8px;
      width: 100%;
      max-width: 320px;
    }
    .pix-step {
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.8rem;
      color: var(--muted);
    }
    .pix-step .num {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--bg3);
      border: 1px solid var(--borda);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 700;
      font-size: 0.78rem;
      color: var(--laranja);
      flex-shrink: 0;
    }

    /* ---- BOTÃO PRINCIPAL ---- */
    .btn-pagar {
      background: var(--laranja);
      color: #000;
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 900;
      font-size: 1.05rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      border: none;
      border-radius: 10px;
      padding: 1rem 1.5rem;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      cursor: pointer;
      transition: all 0.2s;
      margin-top: 1.25rem;
    }
    .btn-pagar:hover {
      background: var(--laranja2);
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(249,115,22,0.35);
    }
    .btn-pagar:active { transform: translateY(0); }
    .btn-pagar:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

    /* ---- CUPOM ---- */
    .cupom-row {
      display: flex;
      gap: 8px;
    }
    .cupom-row .input-dark { flex: 1; text-transform: uppercase; }
    .btn-cupom {
      background: transparent;
      border: 1px solid var(--laranja);
      color: var(--laranja);
      font-family: 'Barlow Condensed', sans-serif;
      font-weight: 700;
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      border-radius: 8px;
      padding: 0 18px;
      cursor: pointer;
      transition: all 0.2s;
      white-space: nowrap;
    }
    .btn-cupom:hover { background: var(--laranja); color: #000; }

    /* ---- SELOS ---- */
    .selos {
      display: flex;
      justify-content: center;
      gap: 20px;
      flex-wrap: wrap;
      margin-top: 14px;
    }
    .selo {
      display: flex;
      align-items: center;
      gap: 5px;
      font-size: 0.7rem;
      color: var(--muted2);
      font-weight: 600;
      letter-spacing: 0.04em;
    }
    .selo i { color: var(--muted); font-size: 0.8rem; }

    /* ---- BANDEIRAS ---- */
    .bandeiras {
      text-align: center;
      font-size: 1.4rem;
      color: var(--muted2);
      letter-spacing: 6px;
      margin-top: 10px;
    }

    /* ---- ENDEREÇO ---- */
    .endereco-card {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      background: var(--bg3);
      border: 1px solid var(--borda);
      border-radius: 8px;
      padding: 12px 14px;
    }
    .endereco-card .icon { color: var(--laranja); margin-top: 2px; }
    .endereco-card .nome-end {
      font-family: 'Barlow Condensed', sans-serif;
      font-size: 0.9rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .endereco-card .txt-end {
      font-size: 0.78rem;
      color: var(--muted);
      margin-top: 2px;
      line-height: 1.5;
    }
    .link-trocar {
      margin-left: auto;
      font-size: 0.72rem;
      color: var(--laranja);
      font-weight: 600;
      text-decoration: none;
      letter-spacing: 0.04em;
      white-space: nowrap;
      align-self: center;
    }
    .link-trocar:hover { color: var(--amarelo); }

    /* ---- AVISO PIX CONFIRMADO ---- */
    .pix-aguardando {
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(34,197,94,0.08);
      border: 1px solid rgba(34,197,94,0.25);
      border-radius: 8px;
      padding: 10px 14px;
      font-size: 0.8rem;
      color: var(--verde);
      font-weight: 600;
      margin-top: 10px;
    }

    @media (max-width: 576px) {
      .metodos { grid-template-columns: repeat(3,1fr); }
      .card-preview .card-num { font-size: 0.9rem; letter-spacing: 0.14em; }
    }
  </style>
</head>
<body>

<div class="page-wrap">

  <!-- HEADER -->
  <div class="page-header">
    <div class="brand">
      Bio<span>Power</span>
    </div>
    <div class="lock-badge">
      <i class="fas fa-lock" style="font-size:0.7rem;"></i> Ambiente Seguro
    </div>
  </div>

  <div class="row no-gutters" style="gap:0;">

    <!-- COLUNA ESQUERDA -->
    <div class="col-lg-7 pr-lg-3 mb-4 mb-lg-0">

      <!-- Endereço -->
      <div class="sec">
        <div class="sec-title">Entrega</div>
        <div class="endereco-card">
          <i class="fas fa-map-marker-alt icon"></i>
          <div>
            <div class="nome-end">Carlos Henrique Moura</div>
            <div class="txt-end">Av. Brasil, 2240, Bloco A, Apto 54<br>Campinas – SP &nbsp;·&nbsp; CEP 13015-002</div>
          </div>
          <a href="#" class="link-trocar">Trocar →</a>
        </div>
      </div>

      <!-- Pagamento -->
      <div class="sec">
        <div class="sec-title">Forma de Pagamento</div>

        <div class="metodos">
          <div class="metodo-btn ativo" data-metodo="credito" onclick="selecionarMetodo(this)">
            <i class="fas fa-credit-card m-icon"></i>
            <span class="m-label">Crédito</span>
            <span class="m-badge">até 12x</span>
          </div>
          <div class="metodo-btn" data-metodo="debito" onclick="selecionarMetodo(this)">
            <i class="fas fa-credit-card m-icon"></i>
            <span class="m-label">Débito</span>
            <span class="m-badge" style="background:rgba(56,189,248,0.1);color:var(--azul);">à vista</span>
          </div>
          <div class="metodo-btn" data-metodo="pix" onclick="selecionarMetodo(this)">
            <i class="fas fa-qrcode m-icon"></i>
            <span class="m-label">Pix</span>
            <span class="m-badge">5% off</span>
          </div>
        </div>

        <!-- PAINEL CRÉDITO -->
        <div class="painel visivel" id="painel-credito">
          <div class="card-preview" id="cardPreview">
            <div class="card-chip"></div>
            <div class="card-num" id="prevNum">•••• &nbsp;&nbsp;•••• &nbsp;&nbsp;•••• &nbsp;&nbsp;••••</div>
            <div class="card-footer-row">
              <div>
                <div class="cf-lbl">Titular</div>
                <div class="cf-val" id="prevNome">NOME DO TITULAR</div>
              </div>
              <div>
                <div class="cf-lbl">Validade</div>
                <div class="cf-val" id="prevVal">MM/AA</div>
              </div>
              <div class="card-bandeira"><i class="fab fa-cc-visa" id="prevBandeira"></i></div>
            </div>
          </div>

          <div class="row no-gutters" style="gap:12px;">
            <div style="flex:1 1 100%;">
              <label class="form-label-dark">Número do Cartão</label>
              <input class="input-dark" id="numCartao" type="text" placeholder="0000 0000 0000 0000" maxlength="19" autocomplete="cc-number"/>
            </div>
            <div style="flex:1 1 100%;">
              <label class="form-label-dark">Nome do Titular</label>
              <input class="input-dark" id="nomeCartao" type="text" placeholder="Como no cartão" autocomplete="cc-name"/>
            </div>
            <div style="flex:1 1 120px;">
              <label class="form-label-dark">Validade</label>
              <input class="input-dark" id="validadeCartao" type="text" placeholder="MM/AA" maxlength="5" autocomplete="cc-exp"/>
            </div>
            <div style="flex:1 1 100px;">
              <label class="form-label-dark">CVV</label>
              <input class="input-dark" id="cvvCartao" type="text" placeholder="•••" maxlength="4" autocomplete="cc-csc"/>
            </div>
            <div style="flex:1 1 100%;">
              <label class="form-label-dark">Parcelamento</label>
              <select class="input-dark" id="parcelas">
                <option>1x de R$ 263,47 — sem juros</option>
                <option>2x de R$ 131,74 — sem juros</option>
                <option>3x de R$ 87,82 — sem juros</option>
                <option selected>6x de R$ 43,91 — sem juros</option>
                <option>12x de R$ 23,72 — com juros (1,99%)</option>
              </select>
            </div>
          </div>
        </div>

        <!-- PAINEL DÉBITO -->
        <div class="painel" id="painel-debito">
          <div class="card-preview">
            <div class="card-chip"></div>
            <div class="card-num" id="prevNumDeb">•••• &nbsp;&nbsp;•••• &nbsp;&nbsp;•••• &nbsp;&nbsp;••••</div>
            <div class="card-footer-row">
              <div>
                <div class="cf-lbl">Titular</div>
                <div class="cf-val" id="prevNomeDeb">NOME DO TITULAR</div>
              </div>
              <div>
                <div class="cf-lbl">Validade</div>
                <div class="cf-val" id="prevValDeb">MM/AA</div>
              </div>
              <div class="card-bandeira"><i class="fab fa-cc-mastercard" id="prevBandeiraDeb"></i></div>
            </div>
          </div>

