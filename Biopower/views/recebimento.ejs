<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Bio-Power | Pagamento</title>

    <link rel="shortcut icon" href="/assets/imgs/img-icon-site.png" type="image/x-icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <link rel="stylesheet" href="/bootstrap-5.0.2-dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/assets/css/navbar.css" />
    <link rel="stylesheet" href="/assets/css/rodape.css" />
    <link rel="stylesheet" href="/assets/css/screen/product-list-screen.css" />

  <link rel="stylesheet" href="../assets/css/screen/carrinho.css">
  <link rel="stylesheet" href="/assets/css/screen/recebimento.css" />
</head>
<body>

<div class="page-wrap">

  <!-- HEADER -->
  <div class="page-header">
    <div class="checkout-heading">
      <div class="brand">
        Bio<span>-Power</span>
      </div>
      <small>Revise seus dados e escolha a forma de pagamento</small>
    </div>
    <div class="lock-badge">
      <i class="fas fa-lock" style="font-size:0.7rem;"></i> Ambiente Seguro
    </div>
  </div>

  <div class="row no-gutters" style="gap:0;">

    <!-- COLUNA ESQUERDA -->
    <div class="col-lg-7 pr-lg-3 mb-4 mb-lg-0">

      <!-- Pagamento -->
      <div class="sec checkout-tabs-card checkout-tabs-card--pagamento">
        <div class="checkout-tabs" role="tablist" aria-label="Etapas do checkout">
          <button class="checkout-tab active" type="button" data-tab="pagamento">Forma de pagamento</button>
          <button class="checkout-tab" type="button" data-tab="nfe">Dados NF-e</button>
          <button class="checkout-tab" type="button" data-tab="entrega">Entrega</button>
        </div>

        <div class="checkout-tab-panel active" data-tab-panel="pagamento">
          <div class="metodos">
          <div class="metodo-btn ativo" data-metodo="credito" onclick="selecionarMetodo(this)">
            <i class="fas fa-credit-card m-icon"></i>
            <span class="m-label">Cartão de crédito</span>
            <span class="m-badge">até 12x</span>
          </div>
          <div class="metodo-btn" data-metodo="debito" onclick="selecionarMetodo(this)">
            <i class="fas fa-credit-card m-icon"></i>
            <span class="m-label">Cartão de débito</span>
            <span class="m-badge" style="background:rgba(56,189,248,0.1);color:var(--azul);">à vista</span>
          </div>
          <div class="metodo-btn" data-metodo="pix" onclick="selecionarMetodo(this)">
            <i class="fas fa-qrcode m-icon"></i>
            <span class="m-label">Pix</span>
            <span class="m-badge">5% off</span>
          </div>
        </div>

          <!-- PAINEL CRÉDITO -->
        <div class="painel visivel" id="painel-credito">
          <div class="card-preview" id="cardPreview">
            <div class="card-chip"></div>
            <div class="card-num" id="prevNum">•••• &nbsp;&nbsp;•••• &nbsp;&nbsp;•••• &nbsp;&nbsp;••••</div>
            <div class="card-footer-row">
              <div>
                <div class="cf-lbl">Titular</div>
                <div class="cf-val" id="prevNome">NOME DO TITULAR</div>
              </div>
              <div>
                <div class="cf-lbl">Validade</div>
                <div class="cf-val" id="prevVal">MM/AA</div>
              </div>
              <div class="card-bandeira"><i class="fab fa-cc-visa" id="prevBandeira"></i></div>
            </div>
          </div>

          <div class="row no-gutters" style="gap:12px;">
            <div style="flex:1 1 100%;">
              <label class="form-label-dark">Número do cartão</label>
              <input class="input-dark" id="numCartao" type="text" placeholder="0000 0000 0000 0000" maxlength="19" autocomplete="cc-number"/>
            </div>
            <div style="flex:1 1 100%;">
              <label class="form-label-dark">Nome do titular</label>
              <input class="input-dark" id="nomeCartao" type="text" placeholder="Como está no cartão" autocomplete="cc-name"/>
            </div>
            <div style="flex:1 1 120px;">
              <label class="form-label-dark">Validade</label>
              <input class="input-dark" id="validadeCartao" type="text" placeholder="MM/AA" maxlength="5" autocomplete="cc-exp"/>
            </div>
            <div style="flex:1 1 100px;">
              <label class="form-label-dark">CVV</label>
              <input class="input-dark" id="cvvCartao" type="text" placeholder="•••" maxlength="4" autocomplete="cc-csc"/>
            </div>
            <div style="flex:1 1 100%;">
              <label class="form-label-dark">Parcelamento</label>
              <select class="input-dark" id="parcelas">
                <option>Calculando parcelamento...</option>
              </select>
            </div>
          </div>
        </div>

        <div class="painel" id="painel-debito">
          <div class="card-preview">
            <div class="card-chip"></div>
            <div class="card-num" id="prevNumDeb">•••• &nbsp;&nbsp;•••• &nbsp;&nbsp;•••• &nbsp;&nbsp;••••</div>
            <div class="card-footer-row">
              <div>
                <div class="cf-lbl">Titular</div>
                <div class="cf-val" id="prevNomeDeb">NOME DO TITULAR</div>
              </div>
              <div>
                <div class="cf-lbl">Validade</div>
                <div class="cf-val" id="prevValDeb">MM/AA</div>
              </div>
              <div class="card-bandeira"><i class="fab fa-cc-mastercard" id="prevBandeiraDeb"></i></div>
            </div>
          </div>

          <div class="row no-gutters" style="gap:12px;">
            <div style="flex:1 1 100%;">
              <label class="form-label-dark">Número do cartão</label>
              <input class="input-dark" id="numDeb" type="text" placeholder="0000 0000 0000 0000" maxlength="19"
                oninput="fmtNum(this); atualizarDebito()"/>
            </div>
            <div style="flex:1 1 100%;">
              <label class="form-label-dark">Nome do titular</label>
              <input class="input-dark" id="nomeDeb" type="text" placeholder="Como está no cartão"
                oninput="document.getElementById('prevNomeDeb').textContent=this.value.toUpperCase()||'NOME DO TITULAR'"/>
            </div>
            <div style="flex:1 1 120px;">
              <label class="form-label-dark">Validade</label>
              <input class="input-dark" id="valDeb" type="text" placeholder="MM/AA" maxlength="5"
                oninput="fmtVal(this); document.getElementById('prevValDeb').textContent=this.value||'MM/AA'"/>
            </div>
            <div style="flex:1 1 100px;">
              <label class="form-label-dark">Senha (4 dígitos)</label>
              <input class="input-dark" type="password" placeholder="••••" maxlength="4"/>
            </div>
          </div>
        </div>

        <!-- PAINEL PIX -->
        <div class="painel" id="painel-pix">
          <div class="pix-wrap">
            <div class="pix-title">
              Escaneie o QR Code abaixo
            </div>

            <div class="pix-qr-container">
              <canvas id="qrCanvas" width="174" height="174"></canvas>
              <div class="pix-logo-overlay">PIX</div>
            </div>

            <div class="pix-timer">
              <i class="fas fa-clock"></i>
              <span>Expira em <strong id="countdown">14:59</strong></span>
            </div>

            <div class="pix-chave">
              <span class="chave-val" id="chavePix">00020126580014BR.GOV.BCB.PIX0136biopower@qr.com5204000053039865406263.475802BR5925BioPower Suplementos6009SAO PAULO62070503***6304A1B2</span>
              <button onclick="copiarPix()" title="Copiar chave Pix">
                <i class="fas fa-copy" id="iconCopy"></i>
              </button>
            </div>

            <div class="pix-steps">
              <div class="pix-step"><div class="num">1</div><span>Abra o app do seu banco</span></div>
              <div class="pix-step"><div class="num">2</div><span>Escolha pagar via Pix com QR Code</span></div>
              <div class="pix-step"><div class="num">3</div><span>Aponte a câmera para o código acima</span></div>
              <div class="pix-step"><div class="num">4</div><span>Confirme o pagamento de <strong style="color:var(--laranja)">R$ 250,30</strong></span></div>
            </div>

            <div class="pix-aguardando">
              <i class="fas fa-circle-notch fa-spin"></i>
              Aguardando confirmação do pagamento...
            </div>

          </div>
        </div>

      </div>

        <div class="checkout-tab-panel" data-tab-panel="nfe">
          <div class="nfe-form-grid">
            <div class="nfe-field">
              <label class="form-label-dark">Nome completo</label>
              <input class="input-dark" type="text" id="inputNome" oninput="validarFormulario()"/>
            </div>
            <div class="nfe-field">
              <label class="form-label-dark">CPF</label>
              <input class="input-dark" type="text" id="inputCpf" placeholder="000.000.000-00" maxlength="14" inputmode="numeric" oninput="mascararCpf(this); validarFormulario()"/>
            </div>
            <div class="nfe-field nfe-field-wide">
              <label class="form-label-dark">E-mail para confirmação</label>
              <input class="input-dark" type="email" id="inputEmail" oninput="validarFormulario()"/>
            </div>
          </div>
        </div>
        <div class="checkout-tab-panel" data-tab-panel="entrega">
          <div class="entrega-form-grid">
            <div class="entrega-field entrega-field-cep">
              <label class="form-label-dark">CEP*</label>
              <div class="cep-search-row">
                <input class="input-dark" type="text" id="inputCep" placeholder="00000-000" maxlength="9" inputmode="numeric" oninput="mascararCep(this); validarFormulario()"/>
                <button class="cep-search-btn" id="btnBuscarCep" type="button" aria-label="Buscar CEP">
                  <i class="fas fa-search"></i>
                </button>
              </div>
            </div>
            <div class="entrega-field entrega-field-bairro">
              <label class="form-label-dark">Bairro*</label>
              <input class="input-dark" type="text" id="inputBairro" oninput="validarFormulario()"/>
            </div>
            <div class="entrega-field entrega-field-cidade">
              <label class="form-label-dark">Cidade*</label>
              <input class="input-dark" type="text" id="inputCidade" oninput="validarFormulario()"/>
            </div>
            <div class="entrega-field entrega-field-uf">
              <label class="form-label-dark">UF*</label>
              <select class="input-dark" id="inputUf" onchange="validarFormulario()">
                <option value="">Selecione</option>
                <option value="AC">AC</option>
                <option value="AL">AL</option>
                <option value="AP">AP</option>
                <option value="AM">AM</option>
                <option value="BA">BA</option>
                <option value="CE">CE</option>
                <option value="DF">DF</option>
                <option value="ES">ES</option>
                <option value="GO">GO</option>
                <option value="MA">MA</option>
                <option value="MT">MT</option>
                <option value="MS">MS</option>
                <option value="MG">MG</option>
                <option value="PA">PA</option>
                <option value="PB">PB</option>
                <option value="PR">PR</option>
                <option value="PE">PE</option>
                <option value="PI">PI</option>
                <option value="RJ">RJ</option>
                <option value="RN">RN</option>
                <option value="RS">RS</option>
                <option value="RO">RO</option>
                <option value="RR">RR</option>
                <option value="SC">SC</option>
                <option value="SP">SP</option>
                <option value="SE">SE</option>
                <option value="TO">TO</option>
              </select>
            </div>
            <div class="entrega-field entrega-field-complemento">
              <label class="form-label-dark">Complemento</label>
              <input class="input-dark" type="text" id="inputComplemento"/>
            </div>
            <div class="entrega-field entrega-field-numero">
              <label class="form-label-dark">Número</label>
              <input class="input-dark" type="text" id="inputNumero" oninput="validarFormulario()"/>
            </div>
            <div class="entrega-field entrega-field-endereco">
              <label class="form-label-dark">Endereço*</label>
              <input class="input-dark" type="text" id="inputEndereco" oninput="validarFormulario()"/>
            </div>
            <span class="cep-status" id="cepStatus"></span>
          </div>
        </div>
      </div>

    </div>

    <!-- COLUNA DIREITA -->
    <div class="col-lg-5 pl-lg-3 ">

      <!-- Resumo -->
      <div class="sec">
        <div class="sec-title">Resumo do pedido</div>

        <div id="resumoPedidoCorpo"></div>

        <div class="mt-3">
          <div class="total-final">
            <div>
              <div class="label">Total</div>
            </div>
            <div class="valor" id="totalValor">R$ <span>0,00</span></div>
          </div>
        </div>
      </div>


      <!-- Botão -->
      <button class="btn-pagar" id="btnPagar" onclick="pagar()">
        <span id="btnTexto">Confirmar pagamento</span>
      </button>

      <!-- Selos -->
      <div class="selos">
        <div class="selo"><i class="fas fa-shield-alt"></i> SSL 256-bit</div>
        <div class="selo"><i class="fas fa-user-shield"></i> Antifraude</div>
        <div class="selo"><i class="fas fa-undo"></i> Devolução fácil</div>
        <div class="selo"><i class="fas fa-truck"></i> Rastreamento</div>
      </div>
      <div class="bandeiras mt-2">
        <i class="fab fa-cc-visa" title="Visa"></i>
        <i class="fab fa-cc-mastercard" title="Mastercard"></i>
        <i class="fab fa-cc-amex" title="Amex"></i>
        <i class="fab fa-cc-elo" title="Elo"></i>
      </div>

    </div>
  </div>
</div>

<!-- QR CODE lib -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<script src="/assets/js/screens/pagamento.js"></script>

<script src="/assets/js/utils/valid-docs.js"></script>
<script src="/assets/js/screens/recebimento.js"></script>
</body>
</html>

