<!DOCTYPE html>
<html lang="pt-br">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bio-Power | Loja</title>

    <link rel="shortcut icon" href="/assets/imgs/img-icon-site.png" type="image/x-icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=League+Spartan:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />

    <link rel="stylesheet" href="/bootstrap-5.0.2-dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/assets/css/navbar.css" />
    <link rel="stylesheet" href="/assets/css/rodape.css" />
    <link rel="stylesheet" href="/assets/css/screen/product-list-screen.css" />
    <link rel="stylesheet" href="/assets/css/screen/carrinho.css" />
  </head>

  <body>
    <%
      const listaProdutos = products || [];
      const laboratoriosFiltro = Array.from(
        new Map(
          listaProdutos
            .filter((p) => p.laboratorioId || p.marca)
            .map((p) => [String(p.laboratorioId || p.marca), { id: p.laboratorioId || p.marca, nome: p.marca || 'Sem marca' }])
        ).values()
      ).sort((a, b) => a.nome.localeCompare(b.nome));

      const categoriasFonte = (typeof categorias !== 'undefined' && categorias && categorias.length)
        ? categorias
        : listaProdutos
            .filter((p) => p.categoriaId || p.categoria)
            .map((p) => ({ id: p.categoriaId || p.categoria, nome: p.categoria || 'Sem categoria' }));
      const categoriasFiltro = Array.from(
        new Map(categoriasFonte.map((c) => [String(c.id || c.nome), { id: c.id || c.nome, nome: c.nome || 'Sem categoria' }]))
      .values()).sort((a, b) => a.nome.localeCompare(b.nome));

      const precoMaximo = Math.max(...listaProdutos.map((p) => Number(p.precoNumber || 0)), 0);
      const precoMaxFiltro = Math.max(50, Math.ceil(precoMaximo / 10) * 10);
    %>

    <!-- ===== BANNER DA LOJA ===== -->
    <section class="store-banner">
      <div class="store-banner-content">
        <nav class="store-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Início</a>
          <i class="fa-solid fa-chevron-right"></i>
          <span>Loja</span>
        </nav>
        <h1 class="store-banner-title">Nossa Loja</h1>
        <p class="store-banner-sub">Suplementos de alto desempenho para sua evolução</p>
      </div>
    </section>

    <!-- ===== BOTÃO SIDEBAR MOBILE ===== -->
    <button class="sidebar-toggle-btn" id="sidebarToggle" aria-label="Abrir filtros">
      <i class="fa-solid fa-sliders"></i> Filtros
    </button>

    <!-- ===== OVERLAY MOBILE ===== -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="store-layout">

      <!-- ===== SIDEBAR ===== -->
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
          <span><i class="fa-solid fa-sliders"></i> Filtrar produtos</span>
          <button class="sidebar-close-btn" id="sidebarClose" aria-label="Fechar filtros">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>

        <!-- Busca rápida -->
        <div class="sidebar-search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="text" id="buscaRapida" placeholder="Buscar produto, categoria ou laboratório..." />
        </div>

        <!-- Laboratórios -->
        <div class="filter-section">
          <button class="filter-toggle" aria-expanded="true">
            <span>Laboratórios</span><i class="fa-solid fa-chevron-down"></i>
          </button>
          <div class="filter-body">
            <% if (laboratoriosFiltro.length) { %>
              <% laboratoriosFiltro.forEach((lab) => { %>
                <label>
                  <input type="checkbox" name="laboratorio" value="<%= lab.id %>" />
                  <%= lab.nome %>
                </label>
              <% }); %>
            <% } else { %>
              <span class="filter-empty">Nenhum laboratório cadastrado.</span>
            <% } %>
          </div>
        </div>

        <!-- Categorias -->
        <div class="filter-section">
          <button class="filter-toggle" aria-expanded="true">
            <span>Categorias</span><i class="fa-solid fa-chevron-down"></i>
          </button>
          <div class="filter-body">
            <% if (categoriasFiltro.length) { %>
              <% categoriasFiltro.forEach((categoria) => { %>
                <label>
                  <input type="checkbox" name="categoria" value="<%= categoria.id %>" />
                  <%= categoria.nome %>
                </label>
              <% }); %>
            <% } else { %>
              <span class="filter-empty">Nenhuma categoria cadastrada.</span>
            <% } %>
          </div>
        </div>

        <!-- Preço -->
        <div class="filter-section">
          <button class="filter-toggle" aria-expanded="true">
            <span>Preço</span><i class="fa-solid fa-chevron-down"></i>
          </button>
          <div class="filter-body">
            <div class="price-range-wrap">
              <input type="range" id="filtroPreco" min="0" max="<%= precoMaxFiltro %>" value="<%= precoMaxFiltro %>" />
              <div class="price-range-labels">
                <span>R$0</span>
                <label class="price-input-inline" for="precoMaxInput">
                  <span>R$</span>
                  <input type="number" id="precoMaxInput" min="0" max="<%= precoMaxFiltro %>" step="1" value="<%= precoMaxFiltro %>" inputmode="decimal" />
                </label>
              </div>
            </div>
          </div>
        </div>

        <button id="limparFiltros" class="btn-limpar-filtros">
          <i class="fa-solid fa-rotate-left"></i> Limpar Filtros
        </button>
      </aside>

      <!-- ===== ÁREA DE PRODUTOS ===== -->
      <div class="products-area">

        <!-- Barra de ordenação -->
        <div class="sort-bar">
          <span class="sort-count" id="contadorProdutos">
            <strong><%= products ? products.length : 0 %></strong> produtos encontrados
          </span>
          <div class="sort-controls">
            <label for="ordenacao" class="sort-label">Ordenar por:</label>
            <select id="ordenacao" class="sort-select">
              <option value="relevancia">Relevância</option>
              <option value="menor-preco">Menor Preço</option>
              <option value="maior-preco">Maior Preço</option>
              <option value="nome-az">Nome A–Z</option>
            </select>
          </div>
        </div>

        <!-- Grid de produtos -->
        <div class="products" id="productsGrid">
          <% if (products && products.length) { %>
            <% products.forEach((product, index) => { %>
              <%
                const precoNum = Number(product.precoNumber) || parseFloat(
                  String(product.preco || '0').replace(/[^\d,]/g, '').replace(',', '.')
                ) || 0;
                const temDesconto = !!product.desconto;
              %>
              <div class="product-card"
                   data-price="<%= precoNum %>"
                   data-id="<%= product.id %>"
                   data-name="<%= product.nome %>"
                   data-category="<%= product.categoriaId || product.categoria %>"
                   data-brand="<%= product.laboratorioId || product.marca %>"
                   data-search="<%= [product.nome, product.categoria, product.marca].filter(Boolean).join(' ') %>"
                   data-index="<%= index %>">

                <% if (temDesconto) { %>
                  <span class="product-badge">Oferta</span>
                <% } %>

                <div class="product-img-wrap">
                  <img src="<%= product.imagem %>" alt="<%= product.alt %>" loading="lazy" />
                </div>

                <div class="product-info">
                  <h3 class="product-name"><%= product.nome %></h3>

                  <div class="product-stars">
                    <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-regular fa-star"></i>
                  </div>

                  <div class="product-pricing">
                    <% if (product.desconto) { %>
                      <span class="product-old-price"><%= product.desconto %></span>
                    <% } %>
                    <span class="product-price"><%= product.preco %></span>
                  </div>

                  <% if (product.credito) { %>
                    <p class="product-credit"><%= product.credito %></p>
                  <% } %>

                  <div class="product-qty" aria-label="Quantidade">
                    <button class="product-qty-btn" type="button" data-acao="menos" aria-label="Diminuir quantidade">
                      <i class="fa-solid fa-minus"></i>
                    </button>
                    <input class="product-qty-input" type="number" min="1" max="99" value="1" inputmode="numeric" aria-label="Quantidade do produto" />
                    <button class="product-qty-btn" type="button" data-acao="mais" aria-label="Aumentar quantidade">
                      <i class="fa-solid fa-plus"></i>
                    </button>
                  </div>

                  <div class="product-actions">
                    <button data-produto="<%= product.id %>" class="btn-buy" type="button">
                      <i class="fa-solid fa-bolt"></i> Comprar
                    </button>
                    <button class="btn-cart" type="button" aria-label="Adicionar ao carrinho">
                      <i class="fa-solid fa-cart-shopping"></i>
                    </button>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div class="empty-state">
              <i class="fa-solid fa-box-open"></i>
              <h3>Nenhum produto encontrado</h3>
              <p>Tente ajustar os filtros ou busque por outro termo.</p>
            </div>
          <% } %>
        </div>

        <!-- Estado vazio pós-filtro -->
        <div class="no-results-msg" id="noResults" style="display:none">
          <i class="fa-solid fa-magnifying-glass"></i>
          <h3>Nenhum resultado</h3>
          <p>Nenhum produto corresponde aos filtros selecionados.</p>
          <button onclick="document.getElementById('limparFiltros').click()">Limpar filtros</button>
        </div>

      </div>
    </div>

    <script src="/assets/js/navbar-script.js"></script>
    <script>
      // ======== SIDEBAR MOBILE ========
      const toggleBtn  = document.getElementById('sidebarToggle');
      const closeBtn   = document.getElementById('sidebarClose');
      const overlay    = document.getElementById('sidebarOverlay');
      const sidebar    = document.getElementById('sidebar');

      function openSidebar()  { sidebar.classList.add('open'); overlay.classList.add('visible'); }
      function closeSidebar() { sidebar.classList.remove('open'); overlay.classList.remove('visible'); }

      toggleBtn.addEventListener('click', openSidebar);
      closeBtn.addEventListener('click', closeSidebar);
      overlay.addEventListener('click', closeSidebar);

      // ======== ACCORDION FILTROS ========
      document.querySelectorAll('.filter-toggle').forEach(btn => {
        btn.addEventListener('click', () => {
          const body    = btn.nextElementSibling;
          const icon    = btn.querySelector('i');
          const isOpen  = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!isOpen));
          body.style.display = isOpen ? 'none' : 'block';
          icon.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
        });
      });

      // ======== RANGE DE PREÇO ========
      const rangeInput  = document.getElementById('filtroPreco');
      const precoMaxInput = document.getElementById('precoMaxInput');

      function limitarPreco(valor) {
        const max = Number(rangeInput.max || 0);
        const min = Number(rangeInput.min || 0);
        const numero = Number(String(valor || '').replace(',', '.'));
        if (!Number.isFinite(numero)) return max;
        return Math.min(Math.max(numero, min), max);
      }

      function atualizarFiltroPreco(valor, aplicar = true) {
        const preco = limitarPreco(valor);
        rangeInput.value = preco;
        if (precoMaxInput) precoMaxInput.value = Math.round(preco);
        if (aplicar) aplicarFiltros();
      }

      rangeInput.addEventListener('input', () => {
        atualizarFiltroPreco(rangeInput.value);
      });

      if (precoMaxInput) {
        precoMaxInput.addEventListener('input', () => {
          atualizarFiltroPreco(precoMaxInput.value);
        });
        precoMaxInput.addEventListener('blur', () => {
          atualizarFiltroPreco(precoMaxInput.value, false);
        });
      }

      // ======== FILTROS E BUSCA ========
      const buscaInput   = document.getElementById('buscaRapida');
      const checkboxes   = document.querySelectorAll('.filter-body input[type="checkbox"]');
      const cards        = document.querySelectorAll('#productsGrid .product-card');
      const contador     = document.getElementById('contadorProdutos');
      const noResults    = document.getElementById('noResults');
      const grid         = document.getElementById('productsGrid');

      buscaInput.addEventListener('input', aplicarFiltros);
      checkboxes.forEach(cb => cb.addEventListener('change', aplicarFiltros));

      function aplicarFiltrosDaUrl() {
        const params = new URLSearchParams(window.location.search);
        const categoriaUrl = params.get('categoria');
        const buscaUrl = params.get('q');

        if (buscaUrl) {
          buscaInput.value = buscaUrl;
        }

        if (categoriaUrl) {
          const categoriaCheckbox = [...document.querySelectorAll('input[name="categoria"]')]
            .find((checkbox) => String(checkbox.value) === String(categoriaUrl));
          if (categoriaCheckbox) categoriaCheckbox.checked = true;
        }
      }

      function normalizarTexto(valor) {
        return String(valor || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .trim();
      }

      function aplicarFiltros() {
        const termo      = normalizarTexto(buscaInput.value);
        const precoMax   = parseFloat(rangeInput.value);
        const labsSel    = [...document.querySelectorAll('input[name="laboratorio"]:checked')].map(c => String(c.value));
        const catsSel    = [...document.querySelectorAll('input[name="categoria"]:checked')].map(c => String(c.value));

        let visiveis = 0;

        cards.forEach(card => {
          const texto = normalizarTexto(card.dataset.search || card.dataset.name);
          const preco = parseFloat(card.dataset.price) || 0;
          const laboratorio = String(card.dataset.brand || '');
          const categoria = String(card.dataset.category || '');

          const passaBusca = !termo || texto.includes(termo);
          const passaPreco = preco <= precoMax;
          const passaLab = labsSel.length === 0 || labsSel.includes(laboratorio);
          const passaCat = catsSel.length === 0 || catsSel.includes(categoria);

          const visivel = passaBusca && passaPreco && passaLab && passaCat;
          card.style.display = visivel ? '' : 'none';
          if (visivel) visiveis++;
        });

        contador.innerHTML = '<strong>' + visiveis + '</strong> produtos encontrados';
        noResults.style.display  = visiveis === 0 ? 'flex' : 'none';
        grid.style.display       = visiveis === 0 ? 'none' : '';
      }

      // ======== LIMPAR FILTROS ========
      document.getElementById('limparFiltros').addEventListener('click', () => {
        checkboxes.forEach(cb => cb.checked = false);
        atualizarFiltroPreco(rangeInput.max, false);
        buscaInput.value = '';
        window.history.replaceState({}, '', window.location.pathname);
        aplicarFiltros();
      });

      // ======== ORDENAÇÃO ========
      document.getElementById('ordenacao').addEventListener('change', function () {
        const parent = document.getElementById('productsGrid');
        const cardsArr = [...parent.querySelectorAll('.product-card')];

        cardsArr.sort((a, b) => {
          if (this.value === 'menor-preco') return parseFloat(a.dataset.price) - parseFloat(b.dataset.price);
          if (this.value === 'maior-preco') return parseFloat(b.dataset.price) - parseFloat(a.dataset.price);
          if (this.value === 'nome-az')     return (a.dataset.name || '').localeCompare(b.dataset.name || '');
          return parseInt(a.dataset.index) - parseInt(b.dataset.index);
        });

        cardsArr.forEach(c => parent.appendChild(c));
      });

      aplicarFiltrosDaUrl();
      aplicarFiltros();
    </script>
  </body>
</html>
