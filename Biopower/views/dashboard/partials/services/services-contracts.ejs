<!-- SERVIÇOS CONTRATADOS -->
<section class="adm-section <%= isProfessionalPanel ? 'adm-section--active' : '' %>" id="services-contracts">
  <div class="adm-page-header">
    <div>
      <h1>Agendamentos</h1>
      <p>Visualize solicitações e atualize status/observações.</p>
    </div>
  </div>

  <div class="adm-card" id="servicos-contratados-card">
    <div class="adm-card-header adm-card-header--between adm-contracts-header">
      <div class="adm-card-header-title">
        <h3>Lista de contratos</h3>
        <p>Controle centralizado com filtro por status.</p>
      </div>
      <div class="adm-contracts-filters">
        <div class="adm-filter-control">
          <label for="filtroStatusContrato">Status</label>
          <select id="filtroStatusContrato" class="adm-input adm-input--pill">
            <option value="">Todos</option>
            <% (statusServicos || []).forEach(function(st){ %>
              <option value="<%= st %>"><%= st %></option>
            <% }) %>
          </select>
        </div>
      </div>
    </div>

    <% if (!servicosContratados || servicosContratados.length === 0) { %>
      <div class="adm-empty-state" style="margin-bottom:0">
        <i class="fa-solid fa-clipboard-list"></i>
        <h2>Nenhum contrato de serviço</h2>
        <p>Quando os clientes contratarem serviços, você verá os registros aqui.</p>
      </div>
    <% } else { %>
    <div class="adm-table-wrap">
      <table class="adm-table adm-table--dense adm-table--contracts" id="tabela-contratos-servicos">
        <thead>
          <tr>
            <th>Cliente</th>
            <th>Profissional</th>
            <th class="col-status">Status</th>
            <th class="col-valor">Valor</th>
            <th class="col-date">Agendamento</th>
            <th class="col-obs">Obs.</th>
          </tr>
        </thead>
        <tbody>
          <% servicosContratados.forEach(function(c){ %>
          <tr class="js-contract-row" data-contrato-id="<%= c.id %>" data-status="<%= c.status %>">
            <td>
              <div style="display:flex;align-items:center;gap:10px">
                <span class="adm-contract-toggle" style="font-weight:700;color:var(--color-text-muted);flex-shrink:0">▲</span>
                <div style="display:flex;flex-direction:column;gap:2px">
                <strong><%= c.clienteNome %></strong>
                <span style="font-size:0.85rem;color:var(--color-text-muted)"><%= c.clienteEmail %></span>
                </div>
              </div>
            </td>
            <td>
              <strong><%= c.profissionalNome || '-' %></strong>
            </td>
            <td>
              <select class="adm-input adm-select-status js-contrato-status status-<%= c.status %>" data-id="<%= c.id %>">
                <% (statusServicos || []).forEach(function(st){ %>
                  <option value="<%= st %>" <%= c.status === st ? 'selected' : '' %>><%= st %></option>
                <% }) %>
              </select>
            </td>
            <td><strong>R$ <%= Number(c.valorTotal || 0).toFixed(2) %></strong></td>
            <td>
              <span class="adm-date-main"><%= new Date(c.dataAgendamento).toLocaleDateString('pt-BR') %></span>
              <span class="adm-date-sub">Atualizado: <%= new Date(c.dataAtualizacao || c.dataAgendamento).toLocaleDateString('pt-BR') %></span>
            </td>
            <td>
              <input type="text" class="adm-input adm-input--ghost js-contrato-obs" placeholder="Obs. opcional" value="<%= c.observacoes || '' %>" />
            </td>
          </tr>
          <tr class="adm-contract-detail" style="display:none">
            <td colspan="6">
              <% (c.servicos || []).forEach(function(s){ %>
                <div style="display:flex;justify-content:space-between;gap:24px;align-items:center;padding:10px 4px;border-bottom:1px solid var(--color-border);">
                  <div style="display:flex;flex-direction:column;gap:4px">
                    <strong><%= s.nome %></strong>
                    <span style="font-size:0.9rem;color:var(--color-text-muted)">Quantidade: <%= Number(s.quantidade || 0) %></span>
                  </div>
                  <div style="font-size:0.9rem;color:var(--color-text-muted)">
                    Valor Unitário: <strong style="color:var(--color-text)">R$ <%= Number(s.valorUnitario || 0).toFixed(2) %></strong>
                  </div>
                </div>
              <% }) %>
              <% if (!isProfessionalPanel) { %>
                <div style="margin-top:16px;">
                  <label style="display:block;margin-bottom:8px;font-weight:600;color:var(--color-text);">Produtos vinculados ao atendimento</label>
                  <div class="adm-contract-product-form">
                    <select class="adm-input js-produto-select" style="min-width:220px">
                      <option value="">Escolha um produto...</option>
                      <% (products || []).forEach(function(p){ %>
                        <option value="<%= p.id %>" data-nome="<%= p.nome %>" data-preco="<%= p.precoNumber %>"><%= p.nome %> (Estoque: <%= p.estoque %>)</option>
                      <% }) %>
                    </select>
                    <input type="number" class="adm-input js-produto-qty adm-contract-product-qty" min="1" value="1" />
                    <button type="button" class="adm-btn adm-btn--primary js-add-produto">
                      <i class="fa-solid fa-plus"></i> Adicionar
                    </button>
                  </div>

                  <div class="js-produtos-list" style="margin-top:8px">
                    <!-- selected products will appear here -->
                  </div>

                  <div style="display:flex;justify-content:space-between;align-items:center;margin-top:12px;gap:12px">
                    <div>
                      <strong>Total:</strong> <span class="js-produtos-total">R$ 0,00</span>
                    </div>
                    <div>
                      <button type="button" class="adm-btn adm-btn--primary js-cobrar">
                        <i class="fa-solid fa-check"></i> Cobrar
                      </button>
                    </div>
                  </div>
                </div>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</section>
