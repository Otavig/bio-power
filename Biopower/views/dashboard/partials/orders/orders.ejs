<!-- PEDIDOS -->
<% const vendasLista = typeof vendas !== "undefined" && Array.isArray(vendas) ? vendas : []; %>
<% const statusVendasLista = typeof statusVendas !== "undefined" && Array.isArray(statusVendas) ? statusVendas : []; %>
<section class="adm-section" id="orders">
  <div class="adm-page-header">
    <div>
      <h1>Vendas</h1>
      <p>Acompanhe as vendas registradas e seus produtos.</p>
    </div>
  </div>

  <div class="adm-card">
    <div class="adm-card-header adm-card-header--between">
      <div class="adm-card-header-title">
        <h3>Lista de vendas</h3>
      </div>
    </div>

    <% if (vendasLista.length === 0) { %>
      <div class="adm-empty-state" style="margin-bottom:0">
        <i class="fa-solid fa-cart-shopping"></i>
        <h2>Nenhuma venda encontrada</h2>
        <p>Quando vendas forem registradas, elas aparecerão aqui.</p>
      </div>
    <% } else { %>
      <div class="adm-table-wrap">
        <table class="adm-table adm-table--dense" id="tabela-vendas">
          <thead>
            <tr>
              <th>Pedido</th>
              <th>Cliente</th>
              <th>Data</th>
              <th>Atualização</th>
              <th>Itens</th>
              <th>Total</th>
              <th>Pagamento</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% vendasLista.forEach(function(venda) { %>
              <tr class="js-sale-row" data-venda-id="<%= venda.id %>">
                <td>
                  <div style="display:flex;align-items:center;gap:10px">
                    <span class="adm-sale-toggle" style="font-weight:700;color:var(--color-text-muted);flex-shrink:0">+</span>
                    <strong><%= venda.id %></strong>
                  </div>
                </td>
                <td>
                  <div style="display:flex;flex-direction:column;gap:2px">
                    <strong><%= venda.clienteNome %></strong>
                    <% if (venda.clienteEmail) { %>
                      <span style="font-size:0.85rem;color:var(--color-text-muted)"><%= venda.clienteEmail %></span>
                    <% } %>
                  </div>
                </td>
                <td>
                  <span class="adm-date-main">
                    <%= venda.data ? new Date(venda.data).toLocaleDateString('pt-BR') : '-' %>
                  </span>
                </td>
                <td>
                  <span class="adm-date-main">
                    <%= venda.atualizadoEm ? new Date(venda.atualizadoEm).toLocaleDateString('pt-BR') : '-' %>
                  </span>
                </td>
                <td>
                  <%= venda.itens.length %> <%= venda.itens.length === 1 ? 'item' : 'itens' %>
                </td>
                <td><strong>R$ <%= Number(venda.valorTotal || 0).toFixed(2) %></strong></td>
                <td>
                  <div style="display:flex;flex-direction:column;gap:2px;min-width:115px">
                    <strong><%= venda.metodoPagamentoCodigo || '-' %></strong>
                    <% if (venda.metodoPagamentoDescricao) { %>
                      <span style="font-size:0.8rem;color:var(--color-text-muted)"><%= venda.metodoPagamentoDescricao %></span>
                    <% } %>
                  </div>
                </td>
                <td>
                  <select class="adm-form-control js-venda-status" data-venda-id="<%= venda.id %>" style="min-width:150px;height:36px;padding:0 10px;border-radius:8px;border:1px solid var(--color-border);background:var(--color-bg);font-weight:700;color:var(--color-text)">
                    <% statusVendasLista.forEach(function(statusItem) { %>
                      <option value="<%= statusItem.id %>" <%= Number(statusItem.id) === Number(venda.statusId) ? 'selected' : '' %>>
                        <%= statusItem.codigo %>
                      </option>
                    <% }) %>
                  </select>
                  <% if (venda.statusDescricao) { %>
                    <div class="js-venda-status-desc" style="margin-top:4px;font-size:0.78rem;color:var(--color-text-muted)"><%= venda.statusDescricao %></div>
                  <% } %>
                </td>
              </tr>
              <tr class="adm-sale-detail" style="display:none">
                <td colspan="8">
                  <% if (!venda.itens.length) { %>
                    <div style="padding:10px 4px;color:var(--color-text-muted)">
                      Nenhum produto vinculado a esta venda.
                    </div>
                  <% } else { %>
                    <div style="display:grid;gap:8px;padding:6px 0">
                      <% venda.itens.forEach(function(item) { %>
                        <div style="display:grid;grid-template-columns:minmax(220px,1fr) 110px 150px 130px;gap:18px;align-items:center;padding:12px 16px;border:1px solid var(--color-border);border-radius:8px;background:var(--color-bg-soft);">
                          <div style="display:flex;flex-direction:column;gap:4px;min-width:0">
                            <strong style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= item.nome %></strong>
                            <span style="font-size:0.82rem;color:var(--color-text-muted)">Produto #<%= item.produtoId %></span>
                          </div>
                          <div style="font-size:0.9rem;color:var(--color-text-muted)">
                            Qtd. <strong style="color:var(--color-text)"><%= Number(item.quantidade || 0) %></strong>
                          </div>
                          <div style="font-size:0.9rem;color:var(--color-text-muted)">
                            Unitário <strong style="color:var(--color-text)">R$ <%= Number(item.valorUnitario || 0).toFixed(2) %></strong>
                          </div>
                          <div style="font-size:0.9rem;color:var(--color-text-muted);text-align:right">
                            Subtotal <strong style="color:var(--color-text)">R$ <%= Number(item.subtotal || 0).toFixed(2) %></strong>
                          </div>
                      </div>
                      <% }) %>
                    </div>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    const tabelaVendas = document.getElementById("tabela-vendas");
    if (!tabelaVendas) return;

    tabelaVendas.addEventListener("click", function (event) {
      if (event.target.closest("select, input, button, a")) return;

      const row = event.target.closest("tr.js-sale-row");
      if (!row) return;

      const detail = row.nextElementSibling;
      if (!detail || !detail.classList.contains("adm-sale-detail")) return;

      const isOpen = detail.style.display !== "none";
      detail.style.display = isOpen ? "none" : "table-row";

      const icon = row.querySelector(".adm-sale-toggle");
      if (icon) icon.textContent = isOpen ? "+" : "-";
    });

    tabelaVendas.addEventListener("change", async function (event) {
      const select = event.target.closest(".js-venda-status");
      if (!select) return;

      const vendaId = select.dataset.vendaId;
      const valorAnterior = select.dataset.valorAnterior || select.value;
      select.disabled = true;

      try {
        const resposta = await fetch(`/dashboard/orders/${vendaId}/status`, {
          method: "PUT",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          body: JSON.stringify({ statusId: select.value })
        });
        const corpo = await resposta.json();

        if (!resposta.ok || !corpo.ok) {
          throw new Error(corpo.msg || "Nao foi possivel atualizar o status.");
        }

        select.dataset.valorAnterior = select.value;
        const desc = select.closest("td")?.querySelector(".js-venda-status-desc");
        if (desc && corpo.status?.descricao) desc.textContent = corpo.status.descricao;
      } catch (erro) {
        select.value = valorAnterior;
        if (window.Swal) {
          Swal.fire({ icon: "error", title: "Erro", text: erro.message });
        } else {
          alert(erro.message);
        }
      } finally {
        select.disabled = false;
      }
    });

    tabelaVendas.querySelectorAll(".js-venda-status").forEach(function (select) {
      select.dataset.valorAnterior = select.value;
    });
  });
</script>
