<!-- CUPONS -->
<section class="adm-section" id="coupons">
  <div class="adm-page-header">
    <div>
      <h1>Cupons & Promoções</h1>
      <p>Gerencie descontos e campanhas ativas.</p>
    </div>

    <button class="adm-btn adm-btn--primary"
      onclick="document.getElementById('dialog-novo-cupom').classList.add('adm-dialog--open')">
      <i class="fa-solid fa-plus"></i>
      Novo cupom
    </button>
  </div>

  <div class="adm-card">
    <div class="adm-table-wrap">
      <table class="adm-table">
        <thead>
          <tr>
            <th>Código</th>
            <th>Descrição</th>
            <th>Desconto</th>
            <th>Validade</th>
            <th>Aplicação</th>
            <th>Status</th>
            <th>Ações</th>
          </tr>
        </thead>

        <tbody id="couponTableBody"></tbody>

      </table>
    </div>
  </div>
</section>


<!-- DIALOG NOVO CUPOM -->

<div class="adm-dialog" id="dialog-novo-cupom">

  <div class="adm-dialog-backdrop"
    onclick="document.getElementById('dialog-novo-cupom').classList.remove('adm-dialog--open')"></div>

  <div class="adm-dialog-panel" style="max-width:600px">

    <div class="adm-dialog-header">

      <h2>
        <i class="fa-solid fa-ticket"></i>
        Novo cupom
      </h2>

      <button class="adm-dialog-close"
        onclick="document.getElementById('dialog-novo-cupom').classList.remove('adm-dialog--open')">
        &#x2715;
      </button>

    </div>


    <form id="formCreateCoupon" class="adm-form">

      <div class="adm-form-grid">

        <div class="adm-form-group adm-form-group--full">

          <label>Código *</label>

          <input class="adm-input" name="coupon_code" required placeholder="Ex: BCAA10">

        </div>


        <div class="adm-form-group adm-form-group--full">

          <label>Descrição *</label>

          <input class="adm-input" name="coupon_description" required placeholder="Ex: R$10 em aminoácidos">

        </div>


        <div class="adm-form-group">

          <label>Desconto % *</label>

          <input class="adm-input" type="number" name="coupon_discount" required>

        </div>


        <div class="adm-form-group">

          <label>Data início *</label>

          <input class="adm-input" type="date" name="coupon_start_date" required>

        </div>


        <div class="adm-form-group">

          <label>Data fim *</label>

          <input class="adm-input" type="date" name="coupon_end_date" required>

        </div>

        <div class="adm-form-group adm-form-group--full">
          <label class="adm-check-line">
            <input type="checkbox" name="coupon_auto_apply" value="1">
            Aplicar automaticamente em produtos próximos do vencimento
          </label>
        </div>

        <div class="adm-form-group adm-form-group--full coupon-auto-days" hidden>
          <label>Produtos que vencem nos próximos</label>
          <select class="adm-input" name="coupon_expiration_days">
            <option value="30">30 dias</option>
            <option value="60">60 dias</option>
            <option value="90">90 dias</option>
          </select>
        </div>

      </div>


      <div class="adm-dialog-footer">

        <button type="button" class="adm-btn adm-btn--ghost"
          onclick="document.getElementById('dialog-novo-cupom').classList.remove('adm-dialog--open')">
          Cancelar
        </button>


        <button class="adm-btn adm-btn--primary" type="submit">

          <i class="fa-solid fa-check"></i>
          Criar cupom

        </button>

      </div>


    </form>

  </div>

</div>

<div class="adm-dialog" id="dialog-editar-cupom">
  <div class="adm-dialog-backdrop"
    onclick="document.getElementById('dialog-editar-cupom').classList.remove('adm-dialog--open')"></div>

  <div class="adm-dialog-panel" style="max-width:600px">
    <div class="adm-dialog-header">
      <h2>
        <i class="fa-solid fa-pen-to-square"></i>
        Editar cupom
      </h2>
      <button class="adm-dialog-close"
        onclick="document.getElementById('dialog-editar-cupom').classList.remove('adm-dialog--open')">
        &#x2715;
      </button>
    </div>

    <form id="formEditCoupon" class="adm-form">
      <input type="hidden" name="coupon_id">

      <div class="adm-form-grid">
        <div class="adm-form-group adm-form-group--full">
          <label>Código *</label>
          <input class="adm-input" name="coupon_code" required placeholder="Ex: BCAA10">
        </div>

        <div class="adm-form-group adm-form-group--full">
          <label>Descrição *</label>
          <input class="adm-input" name="coupon_description" required placeholder="Ex: R$10 em aminoácidos">
        </div>

        <div class="adm-form-group">
          <label>Desconto % *</label>
          <input class="adm-input" type="number" name="coupon_discount" required>
        </div>

        <div class="adm-form-group">
          <label>Data início *</label>
          <input class="adm-input" type="date" name="coupon_start_date" required>
        </div>

        <div class="adm-form-group">
          <label>Data fim *</label>
          <input class="adm-input" type="date" name="coupon_end_date" required>
        </div>

        <div class="adm-form-group adm-form-group--full">
          <label class="adm-check-line">
            <input type="checkbox" name="coupon_auto_apply" value="1">
            Aplicar automaticamente em produtos próximos do vencimento
          </label>
        </div>

        <div class="adm-form-group adm-form-group--full coupon-auto-days" hidden>
          <label>Produtos que vencem nos próximos</label>
          <select class="adm-input" name="coupon_expiration_days">
            <option value="30">30 dias</option>
            <option value="60">60 dias</option>
            <option value="90">90 dias</option>
          </select>
        </div>

        <div class="adm-form-group adm-form-group--full">
          <label>Status do Cupom *</label>
          <select class="adm-input" name="coupon_status" required>
            <option value="1">Ativo</option>
            <option value="0">Inativo (Desativado)</option>
          </select>
        </div>
      </div>

      <div class="adm-dialog-footer">
        <button type="button" class="adm-btn adm-btn--ghost"
          onclick="document.getElementById('dialog-editar-cupom').classList.remove('adm-dialog--open')">
          Cancelar
        </button>

        <button class="adm-btn adm-btn--primary" type="submit">
          <i class="fa-solid fa-floppy-disk"></i>
          Salvar Alterações
        </button>
      </div>
    </form>
  </div>
</div>
