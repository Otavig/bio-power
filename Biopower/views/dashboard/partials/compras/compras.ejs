<!-- compras -->
<% const comprasLista = typeof compras !== "undefined" && Array.isArray(compras) ? compras : []; %>

<section id="compras" class="adm-section <%= isSupplierPanel ? 'adm-section--active' : '' %>">
  <div class="adm-page-header">
    <div>
      <h1>Compras</h1>
      <p>Gerenciamento de compras a serem realizadas e recebidas.</p>
    </div>

    <% if (!isSupplierPanel) { %>
      <button class="adm-btn adm-btn--primary" id="abrirNovaCompra" type="button">
        <i class="fa-solid fa-plus"></i> Nova compra
      </button>
    <% } %>
  </div>

  <div class="adm-card">
    <div class="adm-card-header adm-card-header--between">
      <div class="adm-card-header-title">
        <h3>Lista de compras</h3>
      </div>
    </div>

    <% if (comprasLista.length === 0) { %>
      <div class="adm-empty-state" style="margin-bottom:0">
        <i class="fa-solid fa-truck-ramp-box"></i>
        <h2>Nenhuma compra encontrada</h2>
        <p>Quando compras forem registradas, elas aparecerao aqui.</p>
      </div>
    <% } else { %>
      <div class="adm-table-wrap">
        <table class="adm-table adm-table--dense" id="tabela-compras">
          <thead>
            <tr>
              <th>Compra</th>
              <th>Fornecedor</th>
              <th>Data</th>
              <th>Itens</th>
              <th>Total</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% comprasLista.forEach(function(compra) { %>
              <% const statusCompra = String(compra.status || "pendente").toLowerCase(); %>
              <% const statusClass = statusCompra === "recebido" || statusCompra === "recebida" ? "success" : statusCompra === "cancelado" || statusCompra === "cancelada" ? "danger" : "warning"; %>
              <tr class="js-purchase-row" data-compra-id="<%= compra.id %>">
                <td>
                  <div style="display:flex;align-items:center;gap:10px">
                    <span class="adm-purchase-toggle" style="font-weight:700;color:var(--color-text-muted);flex-shrink:0">+</span>
                    <strong><%= compra.id %></strong>
                  </div>
                </td>
                <td>
                  <div style="display:flex;flex-direction:column;gap:2px;min-width:0">
                    <strong><%= compra.fornecedorNome %></strong>
                    <% if (compra.fornecedorEmail || compra.fornecedorCnpj) { %>
                      <span style="font-size:0.85rem;color:var(--color-text-muted)"><%= compra.fornecedorEmail || compra.fornecedorCnpj %></span>
                    <% } %>
                  </div>
                </td>
                <td><span class="adm-date-main"><%= compra.data ? new Date(compra.data).toLocaleDateString("pt-BR") : "-" %></span></td>
                <td><%= compra.itens.length %> <%= compra.itens.length === 1 ? "item" : "itens" %></td>
                <td><strong>R$ <%= Number(compra.valorTotal || 0).toFixed(2) %></strong></td>
                <td>
                  <div style="display:flex;align-items:center;gap:8px">
                    <span class="adm-badge adm-badge--<%= statusClass %>"><%= compra.status || "-" %></span>
                    <% if (String(compra.status || "").toLowerCase() === "pendente") { %>
                      <button
                        type="button"
                        class="adm-btn-icon btn-receber-compra"
                        title="Receber compra"
                        data-compra-id="<%= compra.id %>"
                        data-compra-itens='<%= JSON.stringify(compra.itens || []) %>'
                      >
                        <i class="fa-solid fa-download"></i>
                      </button>
                    <% } %>
                  </div>
                </td>
              </tr>
              <tr class="adm-purchase-detail" style="display:none">
                <td colspan="6">
                  <% if (!compra.itens.length) { %>
                    <div style="padding:10px 4px;color:var(--color-text-muted)">Nenhum produto vinculado a esta compra.</div>
                  <% } else { %>
                    <div style="display:grid;gap:8px;padding:6px 0">
                      <% compra.itens.forEach(function(item) { %>
                        <div style="display:grid;grid-template-columns:minmax(220px,1fr) 110px 150px 130px;gap:18px;align-items:center;padding:12px 16px;border:1px solid var(--color-border);border-radius:8px;background:var(--color-bg-soft);">
                          <div style="display:flex;flex-direction:column;gap:4px;min-width:0">
                            <strong style="white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><%= item.nome %></strong>
                            <span style="font-size:0.82rem;color:var(--color-text-muted)">Produto #<%= item.produtoId %></span>
                          </div>
                          <div style="font-size:0.9rem;color:var(--color-text-muted)">Qtd. <strong style="color:var(--color-text)"><%= Number(item.quantidade || 0) %></strong></div>
                          <div style="font-size:0.9rem;color:var(--color-text-muted)">Unitario <strong style="color:var(--color-text)">R$ <%= Number(item.valorUnitario || 0).toFixed(2) %></strong></div>
                          <div style="font-size:0.9rem;color:var(--color-text-muted);text-align:right">Subtotal <strong style="color:var(--color-text)">R$ <%= Number(item.subtotal || 0).toFixed(2) %></strong></div>
                        </div>
                      <% }) %>
                    </div>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</section>

<style>
  #compras .adm-card {
    margin: 0 auto;
    max-width: 1200px;
    width: 100%;
  }

  #compras .adm-table-wrap {
    max-width: 100%;
  }

  #compras .adm-table {
    min-width: 700px;
  }
</style>

<main>
  <%- include('./detalhesCompra') %>
  <%- include('./confirmarRecebimento') %>
  <% if (!isSupplierPanel) { %>
    <%- include('./novaCompra') %>
  <% } %>
</main>

<script src="/assets/js/screens/admin-compras.js"></script>
