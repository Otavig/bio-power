  .product-picker-modal,
  .resumo-compra-modal {
    font-family: 'myriad-pro', sans-serif;
  }
  .nova-compra-modal,
  .product-picker-modal,
  .resumo-compra-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(15, 23, 42, 0.55);
    padding: 24px;
    overflow-y: auto;
  }

  .nova-compra-card,
  .product-picker-card,
  .resumo-compra-card {
    width: min(100%, 960px);
    margin: 40px auto;
    background: #ffffff;
    border-radius: 28px;
    padding: 32px;
    position: relative;
    box-shadow: 0 30px 80px rgba(15, 23, 42, 0.16);
    border: 1px solid rgba(15, 23, 42, 0.08);
  }

  .modal-close {
    position: absolute;
    top: 22px;
    right: 22px;
    width: 42px;
    height: 42px;
    border: none;
    border-radius: 50%;
    background: #f8fafc;
    color: #111827;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .modal-close:hover {
    background: #e2e8f0;
  }

  .nova-compra-header {
    display: grid;
    gap: 12px;
    padding-bottom: 18px;
    border-bottom: 1px solid #ebe5e5;
    margin-bottom: 24px;
  }

  .nova-compra-tag {
    display: inline-flex;
    padding: 8px 14px;
    border-radius: 999px;
    background: #eff6ff;
    color: #391dd8;
    font-weight: 700;
    font-size: 0.82rem;
  }

  .nova-compra-header h2 {
    margin: 0;
    font-size: 2rem;
    color: #0f172a;
    line-height: 1.1;
  }

  .nova-compra-header p {
    margin: 0;
    color: #694747;
    font-size: 1rem;
    line-height: 1.75;
  }

  .selected-items,
  .product-list {
    display: grid;
    gap: 14px;
  }

  .product-card,
  .selected-item {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 18px;
    padding: 16px 18px;
    display: grid;
    gap: 14px;
  }

  .product-summary,
  .selected-product-summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .product-summary strong,
  .selected-product-summary strong {
    font-size: 1rem;
    color: #0f172a;
  }

  .product-summary span,
  .selected-product-summary span {
    color: #694747;
    font-size: 0.95rem;
  }

  .product-stock-info,
  .selected-item-details {
    display: grid;
    gap: 8px;
  }

  .product-stock {
    font-weight: 700;
    color: #0f172a;
  }

  .stock-low {
    color: #b91c1c;
  }

  .stock-warning {
    color: #b91c1c;
    font-weight: 700;
    font-size: 0.9rem;
  }

  .product-actions,
  .selected-product-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .product-price {
    color: #d81d1d;
    font-weight: 700;
  }

  .btn-select-product,
  .btn-remove-product {
    border: none;
    background: #eb2525;
    color: #fff;
    border-radius: 14px;
    padding: 10px 16px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .btn-remove-product {
    background: #ef4444;
  }

  .btn-select-product:hover {
    background: #d81d1d;
  }

  .btn-remove-product:hover {
    background: #dc2626;
  }

  .selected-item input {
    width: 100px;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    padding: 10px 12px;
    font-size: 1rem;
    background: #ffffff;
  }

  .empty-state {
    margin: 0;
    color: #64748b;
  }

  .form-row {
    display: grid;
    gap: 10px;
  }

  .picker-input {
    width: 100%;
    border: 1px solid #d1d5db;
    border-radius: 16px;
    padding: 14px 16px;
    background: #f8fafc;
    color: #111827;
    font-size: 1rem;
    text-align: left;
    cursor: pointer;
  }

  .picker-input:hover {
    border-color: #eb2525;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .form-row label {
    font-weight: 700;
    color: #0f172a;
    font-size: 0.96rem;
  }

  .form-row input {
    width: 100%;
    border: 1px solid #d1d5db;
    border-radius: 16px;
    padding: 14px 16px;
    background: #f8fafc;
    color: #111827;
    font-size: 1rem;
  }

  .form-row input:focus,
  .picker-input:focus {
    outline: none;
    border-color: #eb2525;
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 8px;
  }

  .form-error {
    color: #b91c1c;
    font-size: 0.95rem;
    margin: 0;
    min-height: 20px;
  }

  .btn-submit {
    border: none;
    background: #eb2525;
    color: #ffffff;
    border-radius: 14px;
    padding: 14px 28px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .btn-submit:hover {
    background: #d81d1d;
  }

  .resumo-infos {
    display: grid;
    gap: 10px;
    margin-top: 20px;
    color: #475569;
  }

  .resumo-infos p {
    margin: 0;
  }

  @media (max-width: 720px) {
    .nova-compra-card,
    .product-picker-card,
    .resumo-compra-card {
      margin: 24px auto;
      padding: 24px;
    }

