<div id="novaCompra" class="modal nova-compra-modal">
  <div class="modal-content nova-compra-card">
    <button type="button" id="fecharNovaCompra" class="modal-close">
      <i class="fa-solid fa-xmark"></i>
    </button>

    <div class="nova-compra-header">
      <span class="nova-compra-tag">Nova compra</span>
      <h2>Registrar nova compra</h2>
      <p>Escolha os produtos que deseja comprar e informe a quantidade antes de finalizar.</p>
      <br>
    </div>

    <div class="form-row">
     <label>Fornecedor</label>

      <select name="fornecedorId" id="fornecedorId">
         <option value="">Selecione</option>

        <% fornecedores.forEach(fornecedor => { %>
      <option value="<%= fornecedor.for_id %>">
        <%= fornecedor.for_nome %>
      </option>
    <% }) %>
  </select>
</div>

    <form action="/efetuar-compra" method="POST" class="nova-compra-form" id="novaCompraForm">
      <div class="form-row">
        <label for="abrirPickerProdutos">Produtos</label>
        <button type="button" id="abrirPickerProdutos" class="picker-input">
          Clique para selecionar produtos
        </button>
      </div>

      <div class="selected-items-wrapper">
        <div class="section-title">
          <br>
          <h3>Produtos selecionados</h3>
          <p>Ajuste a quantidade dos itens escolhidos.</p>
        </div>
        <div id="novaCompraSelectedList" class="selected-items">
          <p class="empty-state">Nenhum produto selecionado.</p>
        </div>
      </div>
      <div class="form-grid">
        <div class="form-row">
          <br>
          <label for="totalQuantidade">Quantidade total</label>
          <input id="totalQuantidade" type="number" name="totalQuantidade" readonly placeholder="0" />
        </div>
      </div>

      <input type="hidden" name="selectedProducts" id="novaCompraSelectedProducts" />
      <p id="novaCompraError" class="form-error"></p>

      <div class="form-actions">
        <button type="button" id="btnConfirmarCompra" class="btn-submit">Confirmar compra</button>
      </div>
    </form>
  </div>
</div>

<div id="productPickerModal" class="modal product-picker-modal">
  <div class="modal-content product-picker-card">
    <button type="button" id="fecharProductPicker" class="modal-close">
      <i class="fa-solid fa-xmark"></i>
    </button>
    <div class="nova-compra-header">
      <span class="nova-compra-tag">Selecionar produtos</span>
      <h2>Produtos da loja</h2>
      <p>Escolha os produtos que serão adicionados ao pedido.</p>
    </div>
    <div class="product-list" id="productPickerList">
      <% (products || []).forEach((produto, index) => { %>
        <article class="product-card" data-index="<%= index %>">
          <div class="product-summary">
            <div>
              <strong><%= produto.nome %></strong>
              <span><%= produto.categoria %> • <%= produto.marca %></span>
            </div>
            <div class="product-stock-info">
              <span class="product-stock <%= produto.estoque < 5 ? 'stock-low' : '' %>">Estoque: <%= produto.estoque %></span>
              <% if (produto.estoque < 5) { %>
                <span class="stock-warning">Estoque baixo</span>
              <% } %>
            </div>
          </div>
          <div class="product-actions">
            <span class="product-price"><%= produto.preco %></span>
            <button type="button" class="btn-select-product" data-index="<%= index %>">Selecionar</button>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</div>

<div id="resumoCompraModal" class="modal resumo-compra-modal">
  <div class="modal-content resumo-compra-card">
    <button type="button" id="fecharResumoCompra" class="modal-close">
      <i class="fa-solid fa-xmark"></i>
    </button>
    <div class="nova-compra-header">
      <span class="nova-compra-tag">Resumo da compra</span>
      <h2>Produtos escolhidos</h2>
      <p>Confira os produtos e quantidades antes de finalizar.</p>
    </div>
    <div id="resumoCompraList" class="selected-items"></div>
    <div class="resumo-infos">
      <!-- <p><strong>Lote:</strong> <span id="resumoLote"></span></p>
      <p><strong>Validade:</strong> <span id="resumoValidade"></span></p> -->
      <p><strong>Quantidade total:</strong> <span id="resumoTotal"></span></p>
    </div>
    <div class="form-actions">
      <button type="button" id="btnCancelarResumo" class="adm-btn adm-btn--secondary">Editar</button>
      <button type="button" id="btnFinalizarCompra" class="btn-submit">Finalizar compra</button>
    </div>
  </div>
</div>

<style>
