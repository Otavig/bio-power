<link rel="stylesheet" href="/assets/css/screen/compras/comprasCss.css">

<div class="adm-dialog" id="novaCompra">
  <div class="adm-dialog-backdrop" id="novaCompraBackdrop"></div>
  <div class="adm-dialog-panel adm-dialog-panel--compra">
    <div class="adm-dialog-header">
      <h2 id="novaCompraTitle"><i class="fa-solid fa-truck-ramp-box"></i> Nova compra</h2>
      <button
        class="adm-dialog-close"
        type="button"
        id="fecharNovaCompra"
        aria-label="Fechar"
      >
        &#x2715;
      </button>
    </div>

    <form class="adm-form nova-compra-form" id="novaCompraForm" method="POST" action="/dashboard/compras">
      <div class="adm-form-grid">
        <div class="adm-form-group">
          <label>Fornecedor *</label>
          <select class="adm-input" name="fornecedorId" id="novaCompraFornecedor" required>
            <option value="">Selecione um fornecedor...</option>
            <% (fornecedores || []).forEach(function(fornecedor) { %>
              <option value="<%= fornecedor.id %>"><%= fornecedor.nome %></option>
            <% }) %>
          </select>
        </div>

        <div class="adm-form-group">
          <label>Quantidade total</label>
          <input class="adm-input" id="totalQuantidade" type="number" name="totalQuantidade" readonly placeholder="0" />
        </div>
      </div>

      <div class="adm-form-group adm-form-group--full">
        <label>Produtos *</label>
        <div class="adm-contract-product-form nova-compra-product-form">
          <select class="adm-input" id="novaCompraProdutoSelect">
            <option value="">Escolha um produto...</option>
            <% (products || []).forEach(function(produto) { %>
              <option
                value="<%= produto.id %>"
                data-nome="<%= produto.nome %>"
                data-preco="<%= produto.precoNumber %>"
                data-estoque="<%= produto.estoque %>"
              >
                <%= produto.nome %> (Estoque: <%= produto.estoque %>)
              </option>
            <% }) %>
          </select>
          <input type="number" class="adm-input nova-compra-qty" id="novaCompraProdutoQty" min="1" value="1" placeholder="Qtd" />
          <button type="button" class="adm-btn adm-btn--primary" id="novaCompraAddProduto">
            <i class="fa-solid fa-plus"></i> Adicionar
          </button>
        </div>
      </div>

      <div class="adm-form-group adm-form-group--full">
        <label>Produtos selecionados</label>
        <div id="novaCompraSelectedList" class="selected-items">
          <p class="empty-state" style="text-align:center;padding:1rem;color:var(--color-text-muted)">Nenhum produto selecionado.</p>
        </div>
      </div>

      <input type="hidden" name="produtos" id="novaCompraSelectedProducts" />
      <p id="novaCompraError" class="form-error"></p>

      <div class="adm-dialog-footer">
        <button
          type="button"
          class="adm-btn adm-btn--ghost"
          id="cancelarNovaCompra"
        >
          Cancelar
        </button>
        <button
          type="submit"
          id="btnFinalizarCompra"
          class="adm-btn adm-btn--primary"
        >
          <i class="fa-solid fa-check"></i> <span>Registrar compra</span>
        </button>
      </div>
    </form>
  </div>
</div>
