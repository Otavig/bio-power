<div class="adm-dialog" id="confirmarRecebimento">
  <div class="adm-dialog-backdrop" id="confirmarRecebimentoBackdrop"></div>
  <div class="adm-dialog-panel adm-dialog-panel--recebimento">
    <div class="adm-dialog-header">
      <h2><i class="fa-solid fa-box-check"></i> Confirmar recebimento</h2>
      <button
        class="adm-dialog-close"
        type="button"
        id="fecharConfirmarRecebimento"
        aria-label="Fechar"
      >
        &#x2715;
      </button>
    </div>

    <form id="confirmarRecebimentoForm" class="adm-form">
      <input type="hidden" id="compraIdRecebimento" name="compraId" />

      <div class="adm-form-grid">
        <div class="adm-form-group">
          <label>Número do lote *</label>
          <input
            id="loteProduto"
            name="loteProduto"
            type="text"
            required
            placeholder="Ex: LOTE-COMPRA-12-20260618"
            class="adm-input"
          />
        </div>

        <div class="adm-form-group">
          <label>Data de validade *</label>
          <input
            id="validadeProduto"
            name="validadeProduto"
            type="date"
            required
            class="adm-input"
          />
        </div>
      </div>

      <p id="erroRecebimento" class="form-error"></p>

      <div class="adm-dialog-footer">
        <button
          type="button"
          class="adm-btn adm-btn--ghost"
          id="cancelarConfirmarRecebimento"
        >
          Cancelar
        </button>
        <button
          type="submit"
          class="adm-btn adm-btn--primary"
        >
          <i class="fa-solid fa-check"></i> Confirmar recebimento
        </button>
      </div>
    </form>
  </div>
</div>
