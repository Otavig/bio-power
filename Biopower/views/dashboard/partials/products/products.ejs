<!-- PRODUTOS -->
<section class="adm-section" id="products">
  <div class="adm-page-header">
    <div>
      <h1>Produtos</h1>
      <p>
        Gerencie todo o catálogo da Bio-Power. (<%= products.length %>
        produto<%= products.length !== 1 ? 's' : '' %>)
      </p>
    </div>
    <button
      class="adm-btn adm-btn--primary"
      id="btnNovoProduto"
    >
      <i class="fa-solid fa-plus"></i> Novo produto
    </button>
  </div>

  <% if (flash === 'produto-adicionado') { %>
  <div class="adm-flash adm-flash--success" id="flashMsg">
    <i class="fa-solid fa-circle-check"></i>
    Produto cadastrado com sucesso!
    <button
      class="adm-flash-close"
      onclick="document.getElementById('flashMsg').remove()"
    >
      &#x2715;
    </button>
  </div>
  <% } %>

  <div class="adm-card">
    <div class="adm-table-wrap">
      <table class="adm-table">
        <thead>
          <tr>
            <th></th>
            <th>Produto</th>
            <th>Categoria</th>
            <th>Marca</th>
            <th>Descrição</th>
            <th>Preço</th>
            <th>Promoção</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody>
          <% if (products.length === 0) { %>
          <tr>
            <td colspan="8" style="text-align:center;padding:2rem;color:var(--gray-500)">
              Nenhum produto cadastrado.
            </td>
          </tr>
          <% } %>
          <% products.forEach(function(p, i) { %>
          <tr>
            <td><span class="adm-small-text"><%= i + 1 %></span></td>
            <td>
              <div class="adm-product-cell">
                <div
                  class="adm-product-thumb"
                  style="background-image:url('<%= p.imagem %>');background-size:cover;background-position:center;"
                ></div>
                <div>
                  <strong><%= p.nome %></strong>
                </div>
              </div>
            </td>
            <td><span class="adm-badge adm-badge--info"><%= p.categoria %></span></td>
            <td><%= p.marca %></td>
            <td><%= p.sabor %></td>
            <td><strong><%= p.preco %></strong></td>
            <td><%= p.desconto || "0%" %></td>
            <td>
              <div class="adm-actions">
                <button
                  type="button"
                  class="adm-btn-icon btn-edit-product"
                  title="Editar"
                  data-id="<%= p.id %>"
                >
                  <i class="fas fa-edit"></i>
                </button>
                <form
                  method="POST"
                  action="/dashboard/products/delete/<%= p.id || i %>"
                  style="display:inline"
                  class="form-delete-product"
                  data-nome="<%= p.nome %>"
                >
                  <button
                    type="button"
                    class="adm-btn-icon adm-btn-icon--danger"
                    title="Excluir"
                  >
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<script type="application/json" id="productsPayload">
  <%- JSON.stringify((products || []).map(function(p) {
    return {
      id: p.id,
      nome: p.nome,
      categoriaId: p.categoriaId,
      laboratorioId: p.laboratorioId,
      precoNumber: p.precoNumber,
      descricao: p.descricao || "",
      descontoNumber: p.descontoNumber || 0,
      imagem: p.imagem || ""
    };
  })).replace(/</g, '\\u003c') %>
</script>

<!-- DIALOG: NOVO PRODUTO -->
<div class="adm-dialog" id="dialog-novo-produto">
  <div
    class="adm-dialog-backdrop"
    onclick="window.closeProductModal ? window.closeProductModal() : document.getElementById('dialog-novo-produto').classList.remove('adm-dialog--open')"
  ></div>
  <div class="adm-dialog-panel adm-dialog-panel--product">
    <div class="adm-dialog-header">
      <h2 id="productModalTitle"><i class="fa-solid fa-box-open"></i> Novo produto</h2>
      <button
        class="adm-dialog-close"
        onclick="window.closeProductModal ? window.closeProductModal() : document.getElementById('dialog-novo-produto').classList.remove('adm-dialog--open')"
      >
        &#x2715;
      </button>
    </div>
    <form
      id="formProduto"
      method="POST"
      action="/dashboard/products"
      class="adm-form"
    >
      <div class="adm-form-grid">
        <div class="adm-form-group adm-form-group--full">
          <label>Nome do produto *</label>
          <input type="text" id="nome" name="nome" required placeholder="Ex: Whey Protein Baunilha 900g" class="adm-input" />
        </div>
        <div class="adm-form-group product-field-category">
          <label>Categoria *</label>
          <select id="categoria" name="categoria" required class="adm-input">
            <option value="">Selecione uma categoria</option>
            <% categorias.forEach(function(c) { %>
              <option value="<%= c.id %>"><%= c.nome %></option>
            <% }); %>
          </select>
        </div>
        <div class="adm-form-group product-field-brand">
          <label>Marca</label>
          <select id="marca" name="marca" class="adm-input">
            <option value="">Selecione uma marca</option>
            <% (typeof laboratorios !== 'undefined' ? laboratorios : []).forEach(function(l) { %>
              <option value="<%= l.id %>"><%= l.nome %></option>
            <% }); %>
          </select>
        </div>
        <div class="adm-form-group product-field-price">
          <label>Preço *</label>
          <input type="text" id="preco" name="preco" required placeholder="Ex: R$129,90" class="adm-input" />
        </div>
        <div class="adm-form-group product-field-description">
          <label>Descrição</label>
          <textarea id="sabor" name="sabor" placeholder="Ex: Whey protein sabor chocolate, embalagem 900g" class="adm-input"></textarea>
        </div>
        <div class="adm-form-group product-field-discount">
          <label>Promoção (%)</label>
          <input type="text" id="desconto" name="desconto" inputmode="decimal" value="0" placeholder="Ex: 10,00" class="adm-input" />
        </div>
        <div class="adm-form-group adm-form-group--full">
          <label>Imagem do produto</label>
          <input type="file" id="imagem" name="imagem" accept="image/jpeg,image/png,image/webp,image/gif" class="adm-input" />
          <img id="previewImgProduto" class="adm-product-image-preview" src="" alt="" />
          <small style="color:#6b7280;margin-top:4px;display:block">JPEG, PNG, WEBP ou GIF · máx. 5 MB</small>
        </div>
      </div>
      <div class="adm-dialog-footer">
        <button
          type="button"
          class="adm-btn adm-btn--ghost"
          onclick="window.closeProductModal ? window.closeProductModal() : document.getElementById('dialog-novo-produto').classList.remove('adm-dialog--open')"
        >
          Cancelar
        </button>
        <button type="button" id="btnSalvarProduto" class="adm-btn adm-btn--primary">
          <i class="fa-solid fa-floppy-disk"></i> <span id="productSubmitText">Salvar produto</span>
        </button>
      </div>
    </form>
  </div>
</div>
