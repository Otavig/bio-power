<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <title>Bio-Power | Recebimento de Produto</title>

    <link
      rel="shortcut icon"
      href="/assets/imgs/img-icon-site.png"
      type="image/x-icon"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <link rel="stylesheet" href="/assets/css/navbar.css" />
  </head>

  <body>
    <div class="product-buy-container">
      <div class="product-top">
        <div class="product-info">
          <h1 class="product-name">Recebimento de Produtos</h1>

          <p>Registrar entrada de estoque.</p>

          <form action="/recebimento" method="POST">
            <div style="margin-bottom: 15px">
              <label>ID do Produto</label>

              <input type="number" name="produtoId" required />
            </div>

            <div style="margin-bottom: 15px">
              <label>Número do Lote</label>

              <input type="text" name="lote" required />
            </div>

            <div style="margin-bottom: 15px">
              <label>Validade</label>

              <input type="date" name="validade" required />
            </div>

            <div style="margin-bottom: 15px">
              <label>Quantidade Recebida</label>

              <input type="number" name="quantidade" required />
            </div>

            <div class="buttons">
              <button type="submit">Confirmar Recebimento</button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <script src="/assets/js/navbar-script.js"></script>
  </body>
</html>
